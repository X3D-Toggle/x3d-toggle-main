<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="adw" version="1.0"/>

  <object class="AdwApplicationWindow" id="main_window">
    <property name="title">X3D Toggle</property>
    <property name="default-width">1040</property>
    <property name="default-height">820</property>
    <property name="width-request">420</property>
    <property name="height-request">500</property>

    <property name="content">
      <object class="GtkBox">
        <property name="orientation">vertical</property>

        <child>
          <object class="AdwHeaderBar">
            <child type="start">
              <object class="GtkToggleButton" id="btn_sidebar_toggle">
                <property name="icon-name">open-menu-symbolic</property>
                <property name="tooltip-text">Toggle Navigation Sidebar</property>
                <property name="active">true</property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <property name="title-widget">
              <object class="GtkLabel" id="header_title_label">
                <property name="label">X3D Toggle</property>
                <style>
                  <class name="x3d-accent"/>
                </style>
              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="child">
              <object class="AdwOverlaySplitView" id="split_view">
                <property name="vexpand">true</property>
                <property name="hexpand">true</property>
                <property name="sidebar-width-fraction">0.24</property>
                <property name="min-sidebar-width">200</property>
                <property name="max-sidebar-width">270</property>

                <property name="sidebar">
                  <object class="GtkBox" id="sidebar_pane">
                    <property name="orientation">vertical</property>
                    <property name="spacing">0</property>
                    <style>
                      <class name="x3d-sidebar-pane"/>
                    </style>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="hscrollbar-policy">never</property>
                        <property name="vexpand">true</property>
                        <property name="child">
                          <object class="GtkListBox" id="sidebar_list">
                            <property name="selection-mode">single</property>
                            <style>
                              <class name="navigation-sidebar"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkSeparator">
                        <property name="orientation">horizontal</property>
                        <property name="margin-top">4</property>
                        <style>
                          <class name="x3d-sidebar-divider"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="sidebar_cta_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <property name="margin-start">10</property>
                        <property name="margin-end">10</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">8</property>
                        <style>
                          <class name="x3d-sidebar-cta"/>
                        </style>
                        <child>
                          <object class="GtkButton" id="btn_global_apply">
                            <property name="label">Apply</property>
                            <property name="hexpand">true</property>
                            <property name="sensitive">false</property>
                            <style>
                              <class name="x3d-sidebar-cta-apply"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_global_cancel">
                            <property name="label">Cancel</property>
                            <property name="hexpand">true</property>
                            <property name="sensitive">false</property>
                            <style>
                              <class name="x3d-sidebar-cta-secondary"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="btn_global_default">
                            <property name="label">Default</property>
                            <property name="hexpand">true</property>
                            <property name="sensitive">false</property>
                            <style>
                              <class name="x3d-sidebar-cta-secondary"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>

                <property name="content">
                  <object class="GtkScrolledWindow" id="content_scroll">
                    <property name="hscrollbar-policy">never</property>
                    <property name="vexpand">true</property>
                    <property name="hexpand">true</property>
                    <property name="child">
                      <object class="GtkStack" id="content_stack">
                        <property name="transition-type">crossfade</property>
                        <property name="vhomogeneous">false</property>
                        <property name="hhomogeneous">false</property>
                        <property name="margin-start">24</property>
                        <property name="margin-end">24</property>
                        <property name="margin-top">16</property>
                        <property name="margin-bottom">20</property>
                      </object>
                    </property>
                  </object>
                </property>

              </object>
            </property>
          </object>
        </child>

      </object>
    </property>
  </object>
</interface>

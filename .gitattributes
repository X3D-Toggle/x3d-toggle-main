# X3D Toggle — Git Attributes & Release Archive Exclusions
# `.gitattributes`
# Controls line endings and excludes repository-internal, CI, agent, IDE,
# and developer-only paths from `git archive` / GitHub release tarballs.

# Consistent LF line endings for POSIX shell scripts, sources, and configs
* text=auto eol=lf
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.css text eol=lf
*.ui text eol=lf
*.xml text eol=lf
*.conf text eol=lf
*.service text eol=lf
*.rules text eol=lf
*.policy text eol=lf
Makefile text eol=lf
*.png binary
*.jpg binary
*.ico binary

# ── Exclude Internal Directories from Public Release Tarballs ──
/.agents export-ignore
/.github export-ignore
/.cache export-ignore
/.vscode export-ignore
/.kdev4 export-ignore
/bin export-ignore
/build export-ignore
/pkg export-ignore

# Retain dev/logging/ directory skeleton without any generated log/audit files
/dev/logging/logs/* export-ignore
/dev/logging/logs/.gitkeep -export-ignore
/dev/logging/audits/* export-ignore
/dev/logging/audits/.gitkeep -export-ignore
*.log export-ignore
trace-*.log export-ignore
vgcore.* export-ignore

# ── Exclude Git, Linter, Maintainer & Scratch Files ────────────
/.gitattributes export-ignore
/.gitignore export-ignore
/.clang-tidy export-ignore
/compile_commands.json export-ignore
/deploy.sh export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/docs/SCRATCHPAD.md export-ignore
/SCRATCHPAD.md export-ignore
*.code-workspace export-ignore
*.kdev4 export-ignore
*.kate-swp export-ignore
.directory export-ignore
*~ export-ignore
